# ===== DeepSeek LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# ===== 浏览器 =====
# 本地 Chrome 路径（留空则用系统默认安装位置自动探测）
BROWSER_EXECUTABLE_PATH=
# 持久化登录态目录
BROWSER_USER_DATA_DIR=./data/browser_profile

# ===== 存储 =====
DB_PATH=./data/sqlite/boss.db
CHROMA_DIR=./data/chroma

# ===== 通知 =====
# 本轮固定 none：不外发通知，仅本地日志 + 控制台提示音
NOTIFY_KIND=none

# ===== 安全/限速分档 =====
# conservative(20/天，默认) | normal(50/天) | aggressive(200/天)
AGENT_SAFETY_TIER=conservative
# 配置上限（实际按 AGENT_SAFETY_TIER 生效）
AGENT_DAILY_SEND_LIMIT=200
# 全局最小动作间隔（秒），实际 ±15s 高斯抖动
AGENT_GLOBAL_MIN_INTERVAL_S=45
# 同一目标冷却天数
AGENT_COOLDOWN_SAME_TARGET_D=7